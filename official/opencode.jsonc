{
  "schema": 1,
  "id": "opencode",
  "display": {
    "name": "OpenCode V2",
    "homepage": "https://opencode.ai/docs",
  },
  "command": "opencode",
  "version": {
    "args": ["--version"],
    "pattern": "(\\d+\\.\\d+\\.\\d+)",
  },
  "transport": {
    "type": "acp",
    "args": ["acp"],
    "native": false,
  },
  "failures": [
    {
      "pattern": "(?i)unauthorized|invalid api key|auth login",
      "kind": "authentication",
    },
    {
      "pattern": "(?i)quota|insufficient|billing|free usage limit|provider[.]free-limit",
      "kind": "quota",
    },
    {
      "pattern": "(?i)rate limit",
      "kind": "rate_limit",
    },
    {
      "pattern": "(?i)overloaded",
      "kind": "overloaded",
    },
    {
      "pattern": "(?i)context (window|length)|too many tokens",
      "kind": "context_overflow",
    },
    {
      "pattern": "(?i)was retired|model not found|unknown model",
      "kind": "model_not_found",
    },
  ],
}
