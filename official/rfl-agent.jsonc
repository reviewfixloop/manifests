{
  "schema": 1,
  "id": "rfl-agent",
  "display": {
    "name": "ReviewFixLoop Agent",
    "description": "Reviews with a model served by OpenRouter, Vercel AI Gateway, Ollama Cloud, or another OpenAI-compatible endpoint",
  },
  // Embedded in the review-fix-loop CLI. The model names its provider, as
  // `<openrouter|vercel|ollama|custom>/<the provider's model id>`, and the agent reads the
  // provider's API key from the variable the provider documents (OPENROUTER_API_KEY,
  // AI_GATEWAY_API_KEY, OLLAMA_API_KEY); `custom` sends to RFL_AGENT_CUSTOM_BASE_URL, or to
  // the endpoint the CLI's configuration sets.
  "command": "rfl-agent",
  "models": { "efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
  // The host deletes its scratch directory with the session; the agent keeps whole command
  // outputs and archived conversations there.
  "transport": { "type": "acp", "args": ["--scratch-dir", "{{scratchDir}}"], "native": true },
  // In a sandbox the agent reads no configuration of the user's: the CLI resolves the `custom`
  // provider's endpoint and key outside it and passes them as RFL_AGENT_CUSTOM_BASE_URL and
  // RFL_AGENT_CUSTOM_API_KEY, and allows the endpoint's host.
  "sandbox": {
    "passEnv": [
      "OPENROUTER_API_KEY",
      "AI_GATEWAY_API_KEY",
      "OLLAMA_API_KEY",
      "RFL_AGENT_CUSTOM_BASE_URL",
      "RFL_AGENT_CUSTOM_API_KEY",
    ],
    "domains": ["openrouter.ai", "ai-gateway.vercel.sh", "ollama.com"],
  },
}
